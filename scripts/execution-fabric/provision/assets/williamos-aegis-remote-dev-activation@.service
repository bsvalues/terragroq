[Unit]
Description=WilliamOS bounded AEGIS activation request

[Service]
Type=oneshot
User=root
Group=root
StandardInput=socket
StandardOutput=socket
StandardError=journal
ExecStart=/usr/local/libexec/williamos-aegis-remote-dev-activation-peer.py
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/williamos-fabric /var/lib/williamos/fabric/ledger /var/lib/williamos-fabric/remote-dev-launch-tickets
RestrictSUIDSGID=yes
LockPersonality=yes
