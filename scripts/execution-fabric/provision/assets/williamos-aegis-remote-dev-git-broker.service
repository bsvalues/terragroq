[Unit]
Description=WilliamOS AEGIS proof-specific credential-isolated Git submit broker
After=williamos-aegis-remote-dev-egress.service
Requires=williamos-aegis-remote-dev-egress.service

[Service]
Type=simple
User=williamos-git-broker
Group=williamos-fabric
UMask=0007
ExecStart=/usr/bin/node /usr/local/libexec/williamos-aegis-remote-dev-git-broker.mjs
LoadCredential=github_account_key:/etc/williamos-fabric/github-account.key
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=-/srv/william/workspaces/WO-TF-REMOTE-DEV-OFFLOAD-001 /run/williamos-fabric /var/lib/williamos-fabric/remote-dev-launch-tickets
InaccessiblePaths=/run/user
MemoryMax=268435456
TasksMax=32
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
