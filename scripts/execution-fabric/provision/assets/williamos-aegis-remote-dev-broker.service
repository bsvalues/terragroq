[Unit]
Description=WilliamOS AEGIS proof-specific protocol egress broker
After=network-online.target williamos-aegis-remote-dev-egress.service
Requires=williamos-aegis-remote-dev-egress.service

[Service]
Type=simple
User=williamos-egress-broker
Group=williamos-egress-broker
ExecStart=/usr/bin/node /usr/local/libexec/williamos-aegis-remote-dev-egress-broker.mjs
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=268435456
TasksMax=32

[Install]
WantedBy=multi-user.target
