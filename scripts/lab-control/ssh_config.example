# Merge these hosts into %USERPROFILE%\.ssh\config after reviewing existing entries.
# This template never disables host-key checking.
Host hermes
    HostName 192.168.1.154
    User bs
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519

Host atlas
    HostName 192.168.1.156
    User bs
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519
