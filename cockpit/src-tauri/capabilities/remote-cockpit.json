{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-cockpit",
  "description": "The exact HERMES origin may request only device key generation and proof signing.",
  "windows": ["main"],
  "remote": {
    "urls": ["https://williamos.lan:3443/*"]
  },
  "permissions": [
    "allow-device-generate-key",
    "allow-device-bind-credential",
    "allow-device-credential",
    "allow-device-sign"
  ]
}
