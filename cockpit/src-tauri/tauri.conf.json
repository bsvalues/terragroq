{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WilliamOS Cockpit",
  "version": "0.1.7",
  "identifier": "com.williamos.cockpit",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["remote-cockpit"],
      "csp": "default-src 'none'; style-src 'self'; navigate-to https://192.168.88.9:3443"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "resources": {
      "target/release/WebView2Loader.dll": ""
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
