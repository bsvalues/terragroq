DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
LOCAL_SETUP_ENABLED="true"
AUTH_SIGNUP_MODE="bootstrap"
# Runtime placement profile. Existing deployments default to hermes-anchor.
WILLIAMOS_DEPLOYMENT_PROFILE="hermes-anchor"
# Stable deployment identity surfaced in health and the County compartment banner.
WILLIAMOS_DEPLOYMENT_ID="personal-hermes"
WILLIAMOS_OWNER_EMAIL=""
# Absolute path to the WilliamOS source checkout for system/governance operations.
WILLIAMOS_PROJECT_ROOT="/absolute/path/to/william-os-devops"
# Absolute path to the real TerraFusion checkout WilliamOS develops (use C:\\... on Windows).
WILLIAMOS_TERRAFUSION_ROOT="/absolute/path/to/terrafusion_os_1.0"
# Optional read-only Core Seven secondary mounts. Any configured path must be the exact worktree root
# whose origin is the named canonical bsvalues repository; absent declarations remain unmounted.
WILLIAMOS_TERRAFUSION_SOVEREIGN_OS_ROOT="/absolute/path/to/terrafusion-os"
WILLIAMOS_TERRAFUSION_FORGE_ROOT="/absolute/path/to/terrafusion-forge"
WILLIAMOS_TERRAFUSION_ATLAS_ROOT="/absolute/path/to/terrafusion-atlas"
WILLIAMOS_TERRAFUSION_DAIS_ROOT="/absolute/path/to/terrafusion-dais"
WILLIAMOS_TERRAFUSION_DOSSIER_ROOT="/absolute/path/to/terrafusion-dossier"
WILLIAMOS_TERRAFUSION_GPT_ROOT="/absolute/path/to/terrafusion-gpt"
# Server-managed Space continuity key. /setup seeds this once and preserves it when the checkout moves.
WILLIAMOS_TERRAFUSION_SPACE_IDENTITY="/absolute/path/to/terrafusion_os_1.0"
GROQ_API_KEY=""
# Sovereign inference seam (#638 R1A) - OpenAI-compatible; today points at local Ollama.
WILLIAMOS_AI_BASE_URL="http://127.0.0.1:11434/v1"
WILLIAMOS_AI_MODEL="llama3.2:3b"
WILLIAMOS_EMBEDDING_MODEL="snowflake-arctic-embed2"
# WILLIAMOS_AI_API_KEY=""  # only for an endpoint that requires a key (Ollama does not)

# County Development example (all service/data/AI endpoints must remain loopback):
# WILLIAMOS_DEPLOYMENT_PROFILE="county-development"
# WILLIAMOS_DEPLOYMENT_ID="benton-county-development"
# DATABASE_URL="postgresql://williamos:LOCAL_SECRET@127.0.0.1:15434/williamos?sslmode=disable"
# BETTER_AUTH_URL="http://127.0.0.1:3200"
# WILLIAMOS_AI_BASE_URL="http://127.0.0.1:11434/v1"
# WILLIAMOS_AI_MODEL="qwen2.5-coder:1.5b"
