{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://william-os.local/schemas/aegis-standing-compute-authority-v1.json",
  "title": "WilliamOS AEGIS Standing Compute Authority v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "authority_id",
    "authority_reference",
    "authority_status",
    "repository",
    "allowed_risk_classes",
    "outcome_eligibility",
    "node_identity",
    "resource_limits",
    "execution_boundary",
    "evidence_policy",
    "standing_integration",
    "workload_adapters"
  ],
  "properties": {
    "$schema": { "const": "./aegis-standing-compute-authority.schema.v1.json" },
    "schema_version": { "const": "1.0" },
    "authority_id": { "const": "aegis-standing-compute-authority-v1" },
    "authority_reference": { "const": "github-issue-586" },
    "authority_status": { "const": "ACTIVE" },
    "repository": { "const": "bsvalues/terragroq" },
    "allowed_risk_classes": {
      "type": "array",
      "prefixItems": [{ "const": "R0" }, { "const": "R1" }],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "outcome_eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "approval_status", "dependency_status"],
      "properties": {
        "origin": { "const": "WILLIAMOS_NATIVE" },
        "approval_status": { "const": "ALREADY_APPROVED" },
        "dependency_status": { "const": "CLEARED" }
      }
    },
    "node_identity": { "$ref": "#/$defs/node_identity" },
    "resource_limits": { "$ref": "#/$defs/resource_limits" },
    "execution_boundary": { "$ref": "#/$defs/execution_boundary" },
    "evidence_policy": { "$ref": "#/$defs/evidence_policy" },
    "standing_integration": { "$ref": "#/$defs/standing_integration" },
    "workload_adapters": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/ci_adapter" },
        { "$ref": "#/$defs/hash_adapter" },
        { "$ref": "#/$defs/compression_adapter" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    }
  },
  "$defs": {
    "node_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "hostname", "machine_id_sha256", "execution_account", "privilege"],
      "properties": {
        "node_id": { "const": "aegis" },
        "hostname": { "const": "aegis" },
        "machine_id_sha256": { "const": "1b490fe20bf3d61dc1f14e3a6e7fe38fc7de69c14face211fdd5afd0544c9c8b" },
        "execution_account": { "const": "williamos-fabric" },
        "privilege": { "const": "non-root-no-sudo" }
      }
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_concurrency", "maximum_cpu_threads", "maximum_memory_bytes", "maximum_runtime_ms", "maximum_output_bytes", "maximum_scratch_write_bytes", "minimum_free_bytes_after_requested_writes"],
      "properties": {
        "maximum_concurrency": { "const": 1 },
        "maximum_cpu_threads": { "const": 12 },
        "maximum_memory_bytes": { "const": 8589934592 },
        "maximum_runtime_ms": { "const": 1800000 },
        "maximum_output_bytes": { "const": 536870912 },
        "maximum_scratch_write_bytes": { "const": 5368709120 },
        "minimum_free_bytes_after_requested_writes": { "const": 107374182400 }
      }
    },
    "execution_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_scope", "durable_storage_allowed", "control_evidence_storage_required", "nas_allowed", "backup_allowed", "archive_authority_allowed", "destructive_disk_allowed", "sudo_allowed", "privilege_escalation_allowed", "scheduler_state", "scheduler_authority", "autonomous_selection"],
      "properties": {
        "network_scope": { "const": "none" },
        "durable_storage_allowed": { "const": false },
        "control_evidence_storage_required": { "const": true },
        "nas_allowed": { "const": false },
        "backup_allowed": { "const": false },
        "archive_authority_allowed": { "const": false },
        "destructive_disk_allowed": { "const": false },
        "sudo_allowed": { "const": false },
        "privilege_escalation_allowed": { "const": false },
        "scheduler_state": { "const": "disabled" },
        "scheduler_authority": { "const": "not-granted" },
        "autonomous_selection": { "const": false }
      }
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_age_ms", "maximum_admission_age_ms", "placement_required", "capability_required", "exact_source_commit_required", "reviewed_adapter_template_profile_digests_required", "one_time_job_claim_required", "lease_and_fencing_required"],
      "properties": {
        "maximum_age_ms": { "const": 300000 },
        "maximum_admission_age_ms": { "const": 86400000 },
        "placement_required": { "const": true },
        "capability_required": { "const": true },
        "exact_source_commit_required": { "const": true },
        "reviewed_adapter_template_profile_digests_required": { "const": true },
        "one_time_job_claim_required": { "const": true },
        "lease_and_fencing_required": { "const": true }
      }
    },
    "standing_integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integration_id", "operation_core_sha256", "runtime_sha256", "resident_runner_sha256", "replay_ledger_sha256", "standing_contract_sha256", "trusted_release_manifest_required", "status"],
      "properties": {
        "integration_id": { "const": "aegis-hash-verify-standing-integration-v1" },
        "operation_core_sha256": { "const": "c5965a206b5f26c0db21176a609775d1ca176409b644bbc241fde74565bd8d8f" },
        "runtime_sha256": { "const": "eb1cf0517caf3a4c4a1935ed8bea73c53fed64cc1ad3effa3963e6e237c22be2" },
        "resident_runner_sha256": { "const": "fd6e7025dad2534f06793e61608f3eada56c9df7061c88001bad1a3a7ece8aab" },
        "replay_ledger_sha256": { "const": "19dc17134e8d2ab09bc1938bd114866c5fbccd39a8830133265c816d9da05112" },
        "standing_contract_sha256": { "const": "0ad6aa6ef3a5e10a19de1417bf82edcf9a7f4b9c12e3c736fa6150b99d4e7163" },
        "trusted_release_manifest_required": { "const": true },
        "status": { "const": "ACTIVE" }
      }
    },
    "blocked_adapter_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload_class", "template_id", "adapter_id", "profile_id", "adapter_sha256", "template_sha256", "profile_sha256", "status"],
      "properties": {
        "workload_class": { "type": "string" },
        "template_id": { "type": "string" },
        "adapter_id": { "type": "null" },
        "profile_id": { "type": "string" },
        "adapter_sha256": { "type": "null" },
        "template_sha256": { "type": "null" },
        "profile_sha256": { "type": "null" },
        "status": { "const": "ADAPTER_BLOCKED" }
      }
    },
    "ci_adapter": {
      "allOf": [
        { "$ref": "#/$defs/blocked_adapter_base" },
        { "properties": { "workload_class": { "const": "CI_BUILD_TEST" }, "template_id": { "const": "aegis.ci-build-test.v1" }, "profile_id": { "const": "williamos.standard-validation.v1" } } }
      ]
    },
    "hash_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload_class", "template_id", "adapter_id", "profile_id", "adapter_sha256", "template_sha256", "profile_sha256", "status"],
      "properties": {
        "workload_class": { "const": "HASH_VERIFY" },
        "template_id": { "const": "aegis.hash-verify.v1" },
        "adapter_id": { "const": "resident-aegis-hash-verify-v1" },
        "profile_id": { "const": "resident-aegis-bounded-hash-verify-v1" },
        "adapter_sha256": { "const": "b0c625b92414bbab62fb3d7356b2e04a179377d8076590fe1c521335eb2a30c9" },
        "template_sha256": { "const": "7217d0486fb67e17d27b7854bb8f44d0ba7d063bddde7d45282c091306d8d58b" },
        "profile_sha256": { "const": "ff8587a3e05eeb0aa7abaa80ed882b0f43010ad2fd119e71f0b58e353dfd2989" },
        "status": { "const": "ACTIVE" }
      }
    },
    "compression_adapter": {
      "allOf": [
        { "$ref": "#/$defs/blocked_adapter_base" },
        { "properties": { "workload_class": { "const": "COMPRESSION" }, "template_id": { "const": "aegis.compression.v1" }, "profile_id": { "const": "tar-zstd.deterministic.v1" } } }
      ]
    }
  }
}
