{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://william-os.local/schemas/execution-fabric-registry-v0.2.json",
  "title": "WilliamOS Execution Fabric Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "scheduler", "nodes"],
  "properties": {
    "schema_version": {"const": "0.3"},
    "generated_at": {"type": "string", "format": "date-time"},
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "authority"],
      "properties": {
        "state": {"const": "disabled"},
        "authority": {"const": "not-granted"},
        "notes": {"type": ["string", "null"]}
      }
    },
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "probe", "confidence"],
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "probe": {"type": "string", "minLength": 1},
        "probe_version": {"type": ["string", "null"]},
        "confidence": {"enum": ["proven", "observed", "declared", "unknown"]},
        "ttl_seconds": {"type": ["integer", "null"], "minimum": 0},
        "notes": {"type": ["string", "null"]}
      }
    },
    "cpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "model", "cores", "threads"],
      "properties": {
        "id": {"type": "string"},
        "socket": {"type": ["string", "null"]},
        "manufacturer": {"type": ["string", "null"]},
        "model": {"type": "string"},
        "cores": {"type": "integer", "minimum": 1},
        "threads": {"type": "integer", "minimum": 1},
        "max_mhz": {"type": ["number", "null"]},
        "numa_node": {"type": ["integer", "null"]}
      }
    },
    "dimm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "capacity_bytes"],
      "properties": {
        "locator": {"type": "string"},
        "bank": {"type": ["string", "null"]},
        "capacity_bytes": {"type": "integer", "minimum": 1},
        "memory_type": {"type": ["string", "null"]},
        "form_factor": {"type": ["string", "null"]},
        "ecc": {"type": ["boolean", "null"]},
        "registered": {"type": ["boolean", "null"]},
        "configured_mhz": {"type": ["number", "null"]},
        "rated_mhz": {"type": ["number", "null"]},
        "manufacturer": {"type": ["string", "null"]},
        "part_number": {"type": ["string", "null"]},
        "serial": {"type": ["string", "null"]}
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "vendor", "model"],
      "properties": {
        "id": {"type": "string"},
        "vendor": {"type": "string"},
        "model": {"type": "string"},
        "pci_bus_id": {"type": ["string", "null"]},
        "uuid": {"type": ["string", "null"]},
        "vram_bytes": {"type": ["integer", "null"], "minimum": 0},
        "vram_used_bytes": {"type": ["integer", "null"], "minimum": 0},
        "vram_source": {"enum": ["nvidia-smi", "win32-videocontroller", null]},
        "driver_version": {"type": ["string", "null"]},
        "cuda_version": {"type": ["string", "null"]},
        "compute_capability": {"type": ["string", "null"]},
        "temperature_c": {"type": ["number", "null"]},
        "utilization_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100}
      }
    },
    "disk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "model", "capacity_bytes"],
      "properties": {
        "id": {"type": "string"},
        "model": {"type": "string"},
        "serial": {"type": ["string", "null"]},
        "capacity_bytes": {"type": ["integer", "null"], "minimum": 1},
        "transport": {"type": ["string", "null"]},
        "rotational": {"type": ["boolean", "null"]},
        "smart_overall": {"type": ["string", "null"]},
        "power_on_hours": {"type": ["integer", "null"], "minimum": 0},
        "reallocated": {"type": ["integer", "null"], "minimum": 0},
        "pending": {"type": ["integer", "null"], "minimum": 0},
        "uncorrectable": {"type": ["integer", "null"], "minimum": 0},
        "filesystems": {"type": "array", "items": {"$ref": "#/$defs/filesystem"}}
      }
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size_bytes"],
      "properties": {
        "partition": {"type": ["string", "null"]},
        "drive_letter": {"type": ["string", "null"]},
        "filesystem": {"type": ["string", "null"]},
        "name": {"type": ["string", "null"]},
        "fstype": {"type": ["string", "null"]},
        "label": {"type": ["string", "null"]},
        "uuid": {"type": ["string", "null"]},
        "mountpoint": {"type": ["string", "null"]},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "state"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "mac": {"type": ["string", "null"]},
        "state": {"enum": ["up", "down", "unknown"]},
        "speed_mbps": {"type": ["number", "null"], "minimum": 0},
        "duplex": {"type": ["string", "null"]},
        "addresses": {"type": "array", "items": {"type": "string"}},
        "default_route": {"type": ["boolean", "null"]}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "state"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string"},
        "version": {"type": ["string", "null"]},
        "state": {"enum": ["healthy", "running", "stopped", "degraded", "unavailable", "unknown"]},
        "endpoint": {"type": ["string", "null"]},
        "details": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exposure": {"type": "string"},
            "authentication": {"type": "string"},
            "filesystem": {"type": "string"},
            "mount_by_uuid": {"type": "boolean"},
            "source": {"type": ["string", "null"]},
            "fstype": {"type": ["string", "null"]},
            "options": {"type": ["string", "null"]},
            "observation": {"type": "string"},
            "start_type": {"type": "string"},
            "models": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "os": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family"],
      "properties": {
        "family": {"enum": ["windows", "linux"]},
        "name": {"type": ["string", "null"]},
        "caption": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]},
        "build": {"type": ["string", "null"]}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow", "deny"],
      "properties": {
        "allow": {"type": "array", "items": {"type": "string"}},
        "deny": {"type": "array", "items": {"type": "string"}},
        "bounded_compute": {"$ref": "#/$defs/bounded_compute_authority"}
      }
    },
    "bounded_compute_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "authority_ref", "state", "repository", "risk_classes", "workload_classes", "node_id", "machine_identity_sha256", "maximum_concurrency", "maximum_cpu_threads", "maximum_memory_bytes", "maximum_runtime_ms", "maximum_output_bytes", "maximum_scratch_write_bytes", "minimum_free_bytes_after_job", "network_scope", "execution_identity", "privilege", "storage_scope", "adapter_policy", "scheduler_state", "scheduler_authority", "autonomous_work_selection", "durable_storage_authority"],
      "properties": {
        "schema": {"const": "aegis-standing-compute-authority/1"},
        "authority_ref": {"const": "github-issue-586"},
        "state": {"const": "granted"},
        "repository": {"const": "bsvalues/terragroq"},
        "risk_classes": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"const": "R0"}, {"const": "R1"}], "items": false},
        "workload_classes": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"const": "CI_BUILD_TEST"}, {"const": "HASH_VERIFY"}, {"const": "COMPRESSION"}], "items": false},
        "node_id": {"const": "aegis"},
        "machine_identity_sha256": {"const": "1b490fe20bf3d61dc1f14e3a6e7fe38fc7de69c14face211fdd5afd0544c9c8b"},
        "maximum_concurrency": {"const": 1},
        "maximum_cpu_threads": {"const": 12},
        "maximum_memory_bytes": {"const": 8589934592},
        "maximum_runtime_ms": {"const": 1800000},
        "maximum_output_bytes": {"const": 536870912},
        "maximum_scratch_write_bytes": {"const": 5368709120},
        "minimum_free_bytes_after_job": {"const": 107374182400},
        "network_scope": {"const": "none"},
        "execution_identity": {"const": "williamos-fabric"},
        "privilege": {"const": "non-root-no-sudo"},
        "storage_scope": {"const": "job-scoped-nvme-scratch-only"},
        "adapter_policy": {"const": "separately-reviewed-active-adapter-required"},
        "scheduler_state": {"const": "disabled"},
        "scheduler_authority": {"const": "not-granted"},
        "autonomous_work_selection": {"const": false},
        "durable_storage_authority": {"const": false}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "machine_id_sha256", "source"],
      "properties": {
        "hostname": {"type": ["string", "null"], "minLength": 1},
        "machine_id_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "source": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "capability_health_axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason", "observed_at", "expires_at", "snapshot_sha256", "evidence_ref"],
      "properties": {
        "state": {"enum": ["READY", "DEGRADED", "FAIL_CLOSED", "PENDING", "UNKNOWN"]},
        "reason": {"type": "string", "minLength": 1},
        "observed_at": {"type": ["string", "null"], "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "snapshot_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "evidence_ref": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "capability_health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compute", "backup_target", "archive_storage", "nas"],
      "properties": {
        "compute": {"$ref": "#/$defs/capability_health_axis"},
        "backup_target": {"$ref": "#/$defs/capability_health_axis"},
        "archive_storage": {"$ref": "#/$defs/capability_health_axis"},
        "nas": {"$ref": "#/$defs/capability_health_axis"}
      }
    },
    "required_mount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "serial", "label", "uuid", "mountpoint"],
      "properties": {
        "role": {"enum": ["primary", "secondary"]},
        "serial": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "uuid": {"type": "string", "minLength": 1},
        "mountpoint": {"type": "string", "pattern": "^/backup-(primary|secondary)$"}
      }
    },
    "capability_evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "max_ttl_hours", "accepted_raw_probe_sha256", "accepted_capability_file_sha256", "accepted_backup_receipt_sha256", "required_mounts"],
      "properties": {
        "schema": {"const": "aegis-capability-evidence-policy/1"},
        "max_ttl_hours": {"type": "number", "exclusiveMinimum": 0, "maximum": 48},
        "accepted_raw_probe_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "accepted_capability_file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "accepted_backup_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "required_mounts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/required_mount"}
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "identity", "role", "availability_class", "authority", "evidence", "capability_health", "cpus", "dimms", "gpus", "disks", "network", "runtimes", "capabilities"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "hostname": {"type": ["string", "null"]},
        "identity": {"$ref": "#/$defs/identity"},
        "role": {"type": "string"},
        "availability_class": {"enum": ["interactive", "resident", "stateful", "secondary", "external", "unknown"]},
        "os": {
          "oneOf": [
            {"$ref": "#/$defs/os"},
            {"type": "null"}
          ]
        },
        "authority": {"$ref": "#/$defs/authority"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "capability_evidence_policy": {"$ref": "#/$defs/capability_evidence_policy"},
        "capability_health": {"$ref": "#/$defs/capability_health"},
        "cpus": {"type": "array", "items": {"$ref": "#/$defs/cpu"}},
        "dimms": {"type": "array", "items": {"$ref": "#/$defs/dimm"}},
        "gpus": {"type": "array", "items": {"$ref": "#/$defs/gpu"}},
        "disks": {"type": "array", "items": {"$ref": "#/$defs/disk"}},
        "network": {"type": "array", "items": {"$ref": "#/$defs/network"}},
        "runtimes": {"type": "array", "items": {"$ref": "#/$defs/runtime"}},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
